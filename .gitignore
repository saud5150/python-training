# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
env/
venv/

# Django migrations (optional: keep if you want to track migration history)
*/migrations/
!*/migrations/__init__.py

# Logs
*.log

# IDE/editor folders
.idea/
.vscode/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Python egg files
*.egg
*.egg-info/
dist/
build/
.eggs/

# Media/static (if generated or collected)
staticfiles/
media/
